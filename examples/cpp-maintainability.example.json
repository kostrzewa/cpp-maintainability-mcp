{
  "clang_version": "22",
  "cxx_standard": "c++20",
  "clean_env": true,
  "clean_env_vars": ["LD_LIBRARY_PATH"],
  "compile_commands": "build/compile_commands.json",
  "include_paths": ["include", "src"],
  "defines": [],
  "scan_mode": "auto",
  "cppcheck_jobs": 0,
  "regression_tolerance": 0.5,
  "tool_paths": {
    "clang_tidy": "/usr/bin/clang-tidy-22",
    "cppcheck": "/usr/bin/cppcheck",
    "libclang": "/usr/lib/llvm-22/lib/libclang.so"
  }
}
